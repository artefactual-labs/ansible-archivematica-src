#!/bin/bash
export STORAGE_SERVICE_URL={{ archivematica_src_fixity_ss_url | quote }}
export STORAGE_SERVICE_USER={{ archivematica_src_fixity_ss_user | quote }}
export STORAGE_SERVICE_KEY={{ archivematica_src_fixity_ss_apikey | quote }}
export REQUESTS_CA_BUNDLE={{ archivematica_src_ca_custom_bundle|default(ca_custom_bundle) | quote }}

# Storage Service database used for fixity selection and summary queries.
export SS_DB_URL={{ archivematica_src_ss_environment.SS_DB_URL | default('') | quote }}

export FIXITY_RUN_USER={{ archivematica_src_fixity_user | quote }}
export FIXITY_RUN_GROUP={{ archivematica_src_fixity_group | quote }}
export FIXITY_LOG_DIR={{ archivematica_src_fixity_log_dir | quote }}
export FIXITY_REPORT_DIR={{ archivematica_src_fixity_report_dir | quote }}
export FIXITY_REPORT_MAX_FILES={{ archivematica_src_fixity_report_max_files | string | quote }}
export FIXITY_DEFAULT_MODE={{ archivematica_src_fixity_default_mode | quote }}
export FIXITY_RANDOM_COUNT={{ archivematica_src_fixity_random_count | string | quote }}
export FIXITY_RANDOM_DAYS={{ archivematica_src_fixity_random_days | string | quote }}
export FIXITY_EMAILS={{ archivematica_src_fixity_emails | join(',') | quote }}
export FIXITY_EMAIL_SENDER={{ archivematica_src_fixity_email_sender | quote }}
export FIXITY_EMAIL_SERVER={{ archivematica_src_fixity_email_server | quote }}
export FIXITY_EMAIL_PORT={{ archivematica_src_fixity_email_port | string | quote }}
export FIXITY_EMAIL_USERNAME={{ archivematica_src_fixity_email_username | quote }}
export FIXITY_EMAIL_PASSWORD={{ archivematica_src_fixity_email_password | quote }}
export FIXITY_EMAIL_USE_TLS={{ archivematica_src_fixity_email_use_tls | quote }}
export FIXITY_EMAIL_USE_SSL={{ archivematica_src_fixity_email_use_ssl | quote }}
export FIXITY_EXCLUDED_AIP_STORES={{ archivematica_src_fixity_excluded_aip_stores | join(',') | quote }}
export FIXITY_RESPECT_EXCLUSIONS={{ archivematica_src_fixity_respect_exclusions | quote }}
export FIXITY_LOCK_ENABLED={{ archivematica_src_fixity_lock_enabled | quote }}
export FIXITY_LOCK_FILE={{ archivematica_src_fixity_lock_file | quote }}
export FIXITY_SCAN_TIMEOUT={{ archivematica_src_fixity_scan_timeout | string | quote }}

{% if archivematica_src_fixity_report_url is defined %}
export REPORT_URL={{ archivematica_src_fixity_report_url | quote }}
{% endif %}
{% if archivematica_src_fixity_report_username is defined %}
export REPORT_USERNAME={{ archivematica_src_fixity_report_username | quote }}
{% endif %}
{% if archivematica_src_fixity_report_password is defined %}
export REPORT_PASSWORD={{ archivematica_src_fixity_report_password | quote }}
{% endif %}
