# {{ ansible_managed }}

[Unit]
Description=Archivematica MCP Server Service
After=syslog.target network.target mysql.service

[Service]
Type=simple
User=archivematica
Group=archivematica
EnvironmentFile=-{{ systemd_environment_path }}/archivematica-mcp-server
{% if archivematica_src_syslog_enabled|bool %}
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=MCPServerStdout
SyslogFacility={{ archivematica_src_syslog_mcpserver_facility }}
{% endif %}
{% if archivematica_src_systemd_credentials|bool %}
ExecStart=sh -c 'export $(cat $SECRETS); {{ archivematica_src_am_virtualenv }}/bin/python -m archivematica.MCPServer.archivematicaMCP'
{% else %}
ExecStart={{ archivematica_src_am_virtualenv }}/bin/python -m archivematica.MCPServer.archivematicaMCP
{% endif %}

[Install]
WantedBy=multi-user.target
